{
  // Configuração do projeto ĀTMĀYÂ para o Cloudflare Workers
  // (novo modelo com ficheiros estáticos). O Cloudflare lê este
  // ficheiro automaticamente quando liga o repositório do GitHub.
  "name": "atmaya",
  "main": "worker.js",
  "compatibility_date": "2026-11-27",

  // Tudo o que está na pasta assets é servido como site estático
  "assets": {
    "directory": "./assets"
  },

  // Ligação à base de dados KV.
  // IMPORTANTE: substitui PASTE_KV_ID pelo ID do teu namespace KV
  // (dashboard Cloudflare → Storage & Databases → KV → coluna ID).
  "kv_namespaces": [
    {
      "binding": "SITE_DB",
      "id": "PASTE_KV_ID"
    }
  ]
}
